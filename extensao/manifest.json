{
  "manifest_version": 3,
  "name": "Bloqueador de Tela — vídeos curtos",
  "version": "1.0",
  "description": "Esconde Shorts (YouTube), Reels (Instagram) e o feed Para Você (TikTok). Controlado pelo app Bloqueador de Tela.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "alarms"],
  "background": { "service_worker": "fundo.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": ["conteudo.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
